# Copy to docker/.env (gitignored) and set real values.
# Compose falls back to the defaults below when a var is unset.

# Gateway auth
API_KEY_WHITELIST=["change-me"]
JWT_SECRET=change-me

# MinIO / object storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# vLLM models
VLLM_PRIMARY_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_PRIMARY_MAX_MODEL_LEN=4096
VLLM_FALLBACK_MODEL=Qwen/Qwen2.5-1.5B-Instruct
VLLM_FALLBACK_MAX_MODEL_LEN=4096
