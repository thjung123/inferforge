FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir uv
COPY pyproject.toml ./
RUN uv pip install --system -r pyproject.toml

COPY gateway ./gateway
COPY common ./common

ENV WORKERS=1
ENV HOST=0.0.0.0
ENV PORT=8080
ENV LOG_LEVEL=info

CMD ["sh", "-c", "exec uvicorn gateway.main:app \
    --host ${HOST} \
    --port ${PORT} \
    --workers ${WORKERS} \
    --log-level ${LOG_LEVEL}"]