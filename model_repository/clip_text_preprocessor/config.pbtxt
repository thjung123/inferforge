name: "clip_text_preprocessor"
backend: "python"
max_batch_size: 32

input [
  { name: "TEXTS" data_type: TYPE_STRING dims: [-1] }
]

output [
  { name: "INPUT_IDS" data_type: TYPE_INT32 dims: [77] },
  { name: "ATTENTION_MASK" data_type: TYPE_INT32 dims: [77] }
]

instance_group [
  { kind: KIND_CPU }
]

parameters {
  { key: "max_length" value: { string_value: "77" } }
}
